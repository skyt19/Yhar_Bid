# Yharbid — Environment Variables Template
# Copy to .env and fill in real values. This file is safe to commit.
# IMPORTANT: GROQ_API_KEY is NOT here — it stays server-side in Supabase secrets only.

# Supabase project URL (public — identifies the project endpoint)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable (anon) key — safe to ship (no access without Firebase token)
# Get from: Supabase dashboard -> Settings -> API -> Project API keys -> anon / public
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_anon_key_here

# Google OAuth Client ID (public; used for Google Calendar OAuth)
# Get from: console.cloud.google.com -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=197558461101-xxxxx.apps.googleusercontent.com
